# Resolve react_native_pods.rb with node to allow for hoisting
# Force a stable Node path so Xcode build scripts (e.g., Hermes) don't resolve to Homebrew Cellar paths
ENV['NODE_BINARY'] = '/usr/local/bin/node'
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_modular_headers!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Royal_ride' do
  config = use_native_modules!
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true
  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Ensure CocoaPods can resolve the generated spec shipped with react-native-maps
  pod 'react-native-maps', :path => '../node_modules/react-native-maps'
  # Google Maps iOS SDKs required when using PROVIDER_GOOGLE
  pod 'GoogleMaps'
  pod 'Google-Maps-iOS-Utils'
  
  # React Native Permissions - Auto-linked by react-native-permissions
 

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Do not fail build on warnings for third-party pods (e.g., Yoga/fmt)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        
        # Ensure Hermes and other RN scripts use a stable Node binary
        config.build_settings['NODE_BINARY'] = '/usr/local/bin/node'
        
        # === NEW FIXES FOR XCODE 16.1 + iOS 18.1 SDK ===
        # Fix for DarwinFoundation module compilation issues
        config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        config.build_settings['CLANG_MODULES_AUTOLINK'] = 'NO'
        config.build_settings['CLANG_ENABLE_MODULE_DEBUGGING'] = 'NO'
        
        # C++ standard fixes - UPDATED TO C++20
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        
        # Deployment target fixes
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '10.15'
        
        # Architecture and build optimizations
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        
        # Additional compiler flags for iOS 18.1 compatibility
        config.build_settings['OTHER_CFLAGS'] = '$(inherited) -Wno-error=non-modular-include-in-framework-module'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -Wno-error=non-modular-include-in-framework-module'
        
        # Code signing
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      end
      
      # Force Hermes script phase to use NODE_BINARY explicitly
      target.shell_script_build_phases.each do |phase|
        next unless phase.name && phase.name.include?('[Hermes]')
        script = phase.shell_script || ''
        unless script.include?('NODE_BINARY')
          # Prepend export and replace plain `node` calls with $NODE_BINARY
          updated = "export NODE_BINARY=\"/usr/local/bin/node\"\n" + script.gsub(/(?<=^|\s)node(?=\s|$)/, '$NODE_BINARY')
          phase.shell_script = updated
        end
      end
    end
  end
end